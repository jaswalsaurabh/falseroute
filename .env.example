# FalseRoute Environment Configuration (Example / Local Development Only)
# Copy to .env for local development. Never commit real credentials or production secrets.

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=localhost

# Web Dashboard Configuration
VITE_API_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
# Local development container connection string
DATABASE_URL=postgresql://falseroute:falseroute@localhost:5432/falseroute_dev?schema=public

# Gemini / Google GenAI Configuration
# In local development with Google Cloud ADC (Application Default Credentials), GEMINI_API_KEY may be omitted.
# For API-key-based prototyping only (do not commit actual keys):
GEMINI_API_KEY=your_gemini_api_key_placeholder

# Observability Configuration
LOG_LEVEL=debug
OTEL_SERVICE_NAME=false-route-local
