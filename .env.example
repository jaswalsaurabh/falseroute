# FalseRoute Environment Configuration (Example / Local Development Only)
# Copy to .env for local development. Never commit real credentials or production secrets.

# Node Environment & Observability
NODE_ENV=development
LOG_LEVEL=debug
ENABLE_TELEMETRY=false

# Control Plane API Configuration
PORT=3000
DATABASE_URL=postgresql://falseroute:falseroute@127.0.0.1:5434/falseroute_dev?schema=public
TEST_DATABASE_URL=postgresql://falseroute:falseroute@127.0.0.1:5434/falseroute_test?schema=public
OPERATOR_ACCESS_TOKEN=not-a-real-local-operator-token
OPERATOR_REPLAY_TOKEN=not-a-real-local-elevated-replay-token
CORS_ORIGINS=http://localhost:5173
EVENT_PUBLISHER_MODE=LOCAL_HTTP
LOCAL_WORKER_PUSH_URL=http://127.0.0.1:8088/pubsub/push
LOCAL_WORKER_PUSH_TOKEN=not-a-real-local-autonomous-push-token

# Worker & Gemini Policy Configuration
# If GEMINI_API_KEY is omitted or empty, the worker operates in degraded mode with unavailable model enrichment.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
WORKER_POLL_INTERVAL_MS=500
WORKER_PORT=8088
AUTONOMOUS_PUSH_MODE=LOCAL_SHARED_SECRET
AUTONOMOUS_LOCAL_PUSH_TOKEN=not-a-real-local-autonomous-push-token
# Keep this lease at least the Gemini operation deadline plus the persistence margin.
GEMINI_OPERATION_DEADLINE_MS=8000
WORKER_CLAIM_PERSISTENCE_MARGIN_MS=5000
WORKER_CLAIM_LEASE_MS=15000

# Web Dashboard Proxy Configuration
VITE_API_TARGET=http://127.0.0.1:3000
