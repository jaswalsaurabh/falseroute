# FalseRoute Environment Configuration (Example / Local Development Only)
# Copy to .env for local development. Never commit real credentials or production secrets.

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=localhost

# Web Dashboard Configuration
VITE_API_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
# Local development container connection string
DATABASE_URL=postgresql://falseroute:falseroute@localhost:5434/falseroute_dev?schema=public


# Gemini / Google GenAI Configuration
# If GEMINI_API_KEY is omitted or empty, the worker operates in degraded mode with unavailable model enrichment.
# Provide a valid API key to enable Live Gemini enrichment:
GEMINI_API_KEY=

# Observability Configuration
LOG_LEVEL=debug
OTEL_SERVICE_NAME=false-route-local
