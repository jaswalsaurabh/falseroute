# Local hybrid development profile. Copy to .env.hybrid.
# Only the Gemini credential is supplied at runtime; never add it here.
NODE_ENV=development
LOG_LEVEL=debug
ENABLE_TELEMETRY=false

PORT=3000
WORKER_PORT=8088
DATABASE_URL=postgresql://falseroute:falseroute@127.0.0.1:5434/falseroute_dev?schema=public
OPERATOR_ACCESS_TOKEN=not-a-real-hybrid-operator-token
OPERATOR_REPLAY_TOKEN=not-a-real-hybrid-replay-token
CORS_ORIGINS=http://localhost:5173

EVENT_PUBLISHER_MODE=PUBSUB_EMULATOR
PUBSUB_PROJECT_ID=falseroute-local
PUBSUB_TOPIC_ID=falseroute-events
PUBSUB_EMULATOR_HOST=127.0.0.1:8085
SYSTEM_MODE=SIMULATED

AUTONOMOUS_PUSH_MODE=PUBSUB_EMULATOR
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=30000
GEMINI_OPERATION_DEADLINE_MS=60000
GEMINI_MAX_RETRIES=1
GEMINI_MAX_CONCURRENCY=2
GEMINI_MAX_QUEUE_SIZE=0
GEMINI_DAILY_TOKEN_LIMIT=1000000
WORKER_POLL_INTERVAL_MS=500
WORKER_CLAIM_PERSISTENCE_MARGIN_MS=5000
WORKER_CLAIM_LEASE_MS=70000

VITE_API_TARGET=http://127.0.0.1:3000
