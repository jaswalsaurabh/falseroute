{
  "name": "false-route",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "node scripts/dev-supervisor.ts",
    "dev:web": "node scripts/dev-supervisor.ts --services=web",
    "dev:api": "node scripts/dev-supervisor.ts --services=api",
    "dev:worker": "node scripts/dev-supervisor.ts --services=worker",
    "dev:services": "node scripts/dev-supervisor.ts --services=api,worker",
    "dev:infra": "docker compose -f infrastructure/docker/compose.yml up -d postgres",
    "dev:infra:down": "docker compose -f infrastructure/docker/compose.yml down",
    "dev:migrate": "node scripts/dev-supervisor.ts --migrate",
    "build": "turbo run build",
    "test": "turbo run test && pnpm test:scripts",
    "test:scripts": "node --test scripts/secret-scanner.test.ts scripts/prisma-guard.test.ts scripts/dev-supervisor.test.ts scripts/dev-process-tree.test.ts",
    "test:integration": "turbo run test:integration --concurrency=1",
    "db:setup:test": "pnpm --filter @false-route/database setup:test",
    "lint": "oxlint --deny-warnings && turbo run lint",
    "lint:fix": "oxlint --fix && turbo run lint:fix",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:docs": "node scripts/check-docs.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:source-policy": "node scripts/check-source-policy.mjs",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "check:secrets": "node scripts/check-secrets.ts --all",
    "check:secrets:staged": "node scripts/check-secrets.ts --staged",
    "guard:credentials": "node scripts/check-secrets.ts --staged",
    "guard:prisma": "node scripts/prisma-guard.ts validate",
    "precommit:check": "pnpm exec lint-staged && pnpm check:docs && pnpm guard:credentials && pnpm guard:prisma",
    "prisma:guard": "node scripts/prisma-guard.ts",
    "check:repo": "node scripts/check-repo.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm check:repo"
  },
  "devDependencies": {
    "@false-route/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
