enum BudgetCategory {
  DAILY_USD
  DAILY_GEMINI_TOKENS
  HOURLY_TOOL_OPERATIONS
}

enum BudgetReservationStatus {
  RESERVED
  CONSUMED
  RELEASED
  EXPIRED
  RECONCILED
}

model BudgetReservationRecord {
  id             String                  @id @default(uuid()) @db.Uuid
  idempotencyKey String                  @unique @map("idempotency_key") @db.VarChar(128)
  category       BudgetCategory          @map("category")
  windowKey      String                  @map("window_key") @db.VarChar(64)
  amountReserved Decimal                 @map("amount_reserved") @db.Decimal(12, 4)
  amountConsumed Decimal?                @map("amount_consumed") @db.Decimal(12, 4)
  status         BudgetReservationStatus @map("status")
  ownerId        String                  @map("owner_id") @db.VarChar(128)
  expiresAt      DateTime                @map("expires_at")
  consumedAt     DateTime?               @map("consumed_at")
  releasedAt     DateTime?               @map("released_at")
  reconciledAt   DateTime?               @map("reconciled_at")
  eventId        String?                 @map("event_id") @db.Uuid
  version        Int                     @default(1)
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  /// Evidence about this reservation's own model attempt: DISPATCHED is written immediately
  /// before the provider request, PRE_CALL_FAILED only when non-dispatch was verified.
  /// NULL means no evidence, which reconciliation must treat as conservatively spent.
  geminiAttemptOutcome String? @map("gemini_attempt_outcome") @db.VarChar(32)

  event IntrusionEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([category, windowKey, status])
  @@index([status, expiresAt])
  @@index([eventId])
  @@map("budget_reservation_records")
}

