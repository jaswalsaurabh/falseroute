enum ProcessingStatus {
  PENDING
  PROCESSING
  ENRICHED
  DECIDED
  FAILED
}

enum ContainmentMode {
  SIMULATED
}

enum EventType {
  UNAUTHORIZED_ACCESS_ATTEMPT
  CREDENTIAL_STUFFING
  SUSPICIOUS_LOGIN
}

enum DeceptionAction {
  ASSIGN_FALSE_ROUTE
  ALLOW
  ALERT_OPERATOR
  OBSERVE
}

enum ProvenanceClassification {
  OBSERVED
  INFERRED
  DERIVED
  UNAVAILABLE
  OPERATOR
}

model IntrusionEvent {
  id                       String                   @id @default(uuid()) @db.Uuid
  occurredAt               DateTime                 @map("occurred_at")
  receivedAt               DateTime                 @map("received_at")
  correlationId            String                   @map("correlation_id") @db.VarChar(64)
  sourceIp                 String                   @map("source_ip") @db.Inet
  targetAsset              String                   @map("target_asset") @db.VarChar(64)
  eventType                EventType                @map("event_type")
  failedLoginCount         Int                      @map("failed_login_count")
  riskIndicators           String[]                 @map("risk_indicators")
  containmentMode          ContainmentMode          @map("containment_mode")
  usedDecoyCredential      Boolean                  @map("used_decoy_credential")
  decoyIdentifier          String?                  @map("decoy_identifier") @db.VarChar(64)
  scenarioKind             String?                  @map("scenario_kind") @db.VarChar(64)
  evidence                 Json?                    @map("evidence") @db.JsonB
  status                   ProcessingStatus         @map("status")
  provenance               ProvenanceClassification @map("provenance")
  processingClaimToken     String?                  @map("processing_claim_token") @db.Uuid
  processingLeaseExpiresAt DateTime?                @map("processing_lease_expires_at")
  processingAttemptCount   Int                      @default(0) @map("processing_attempt_count")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")

  decision          DeceptionDecision?
  ingestionReceipts IngestionReceipt[]
  deliveryAttempts  DeliveryAttempt[]
  toolOperations    ToolOperationLedger[]
  activityEvents    ActivityEventRecord[]
  decoyLeases       DecoyDeploymentLease[]
  falseRouteLeases  FalseRouteLease[]
  quarantineLeases  QuarantineLease[]
  providerIntents    ProviderIntentRecord[]
  replayAttempts     ReplayAttempt[]
  deadLetters        DeadLetterRecord[]
  budgetReservations BudgetReservationRecord[]
  campaignStep       CampaignStepRun?

  @@index([occurredAt])
  @@index([status])
  @@index([correlationId])
  @@index([status, processingLeaseExpiresAt])
  @@map("intrusion_events")
}

