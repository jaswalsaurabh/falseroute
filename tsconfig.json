{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./packages/typescript-config/node.json",
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": ["lint-staged.config.ts", "scripts/**/*.mjs", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
